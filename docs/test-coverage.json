	"separateChecks": [
		{
			"name": "Rust daemon",
			"command": "cargo test --locked --manifest-path packages/env/daemon/Cargo.toml"
		},
		{
			"name": "Native terminal helpers",
			"command": "npm run test:native --workspace @axi/tui"
		},
		{
			"name": "Durable Object runtime",
			"command": "npm run test:workers"
		},
		{
			"name": "Installed archives",
			"command": "npm run verify"
		}
	],
	"unverified": [
		"Live provider/model operation and interactive OAuth acceptance require credentials and explicit runs.",
		"macOS, Windows and ARM64 native execution require those platform runners.",
		"SSH acceptance against an external server requires a configured host.",
		"Visual acceptance requires real terminal applications.",
		"Public declaration checks run through npm run check; V8 does not measure type-only contracts or child-process internals."
	]
}
