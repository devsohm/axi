	"peerDependencies": {
		"esbuild": "^0.28.2",
		"ws": "^8.21.0",
		"react": "^19.3.0"
	},
	"peerDependenciesMeta": {
		"esbuild": {
			"optional": true
		},
		"ws": {
			"optional": true
		},
		"react": {
