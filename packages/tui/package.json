{
	"name": "@axi/tui",
	"version": "0.1.0-rc.1",
	"private": true,
	"type": "module",
	"description": "Terminal rendering and interactive components.",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"native"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:native": "node native/build.mjs",
		"test:native": "node --test native/test.mjs native/test/bridge.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"get-east-asian-width": "1.7.0",
		"marked": "18.1.1",
		"marked-cjk-friendly": "0.1.3"
	}
}
