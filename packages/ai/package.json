{
	"name": "@axi/ai",
	"version": "0.1.0-rc.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js",
		"./dist/images.js",
		"./dist/providers/images/register-builtins.js"
	],
	"scripts": {
		"build": "node scripts/check-model-data.ts && tsc -p tsconfig.json",
		"check:model-data": "node scripts/check-model-data.ts",
		"generate:models": "node scripts/generate-models.ts",
		"generate:catalog": "node scripts/generate-catalog.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./api/anthropic-client": null,
		"./api/anthropic-request": null,
		"./api/anthropic-sse": null,
		"./api/bedrock-client": null,
		"./api/bedrock-request": null,
		"./api/bedrock-stream": null,
		"./api/google-request": null,
		"./api/google-stream": null,
		"./api/mistral-http": null,
		"./api/mistral-request": null,
		"./api/mistral-stream": null,
		"./api/openai-codex-protocol": null,
		"./api/openai-codex-websocket": null,
		"./api/openai-completions-compat": null,
		"./api/openai-completions-messages": null,
		"./api/openai-completions-request": null,
		"./api/options": null,
		"./api/responses-request": null,
		"./providers/builtin": null
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"axi-ai": "dist/cli.js"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@axi/telemetry": "0.1.0-rc.1",
		"@google/genai": "2.21.0",
		"@smithy/node-http-handler": "4.12.1",
		"@smithy/types": "4.19.0",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"openai": "7.19.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.27"
	},
	"private": true,
	"description": "Model providers, streaming, authentication, images, and classifiers.",
	"license": "MIT"
}
